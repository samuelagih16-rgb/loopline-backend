# Copy this file to .env and fill in real values. Never commit .env itself.

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# From your Paystack dashboard → Settings → API Keys & Webhooks.
# Use the TEST secret key while developing — it starts with sk_test_.
# Never expose this key to the frontend or commit it to git.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_secret_key

# The origin your frontend is served from, so CORS knows to allow it.
FRONTEND_ORIGIN=http://127.0.0.1:5500

PORT=4000
NODE_ENV=development
